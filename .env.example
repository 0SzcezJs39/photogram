# Скопируйте этот файл в .env и заполните значения:
#   cp .env.example .env
# .env находится в .gitignore и никогда не попадает в репозиторий.

# --- MariaDB ---
MYSQL_DATABASE=photogram
MYSQL_USER=photogram
MYSQL_PASSWORD=change-me-strong-password
MYSQL_ROOT_PASSWORD=change-me-strong-root-password

# --- S3 (Garage) ---
# Имя бакета и ключ доступа, который импортируется в Garage при первом запуске.
S3_BUCKET_NAME=photogram
S3_ACCESS_KEY=change-me-access-key
S3_SECRET_KEY=change-me-secret-key

# --- JWT ---
# ОБЯЗАТЕЛЬНО. Секрет для подписи HS256-токенов, длина >= 32 байт.
# Сгенерировать: openssl rand -base64 48
# Без этой переменной приложение не стартует.
JWT_SECRET=change-me-openssl-rand-base64-48
